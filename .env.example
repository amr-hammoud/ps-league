# Copy this to .env (Hostinger calls it "Environment Variables" in the Node.js panel).
# Both fields should be changed before going live.

# Password used on the /admin login screen.
ADMIN_PASSWORD=nasa-ps-2026

# Secret used to sign the admin cookie. Any long random string is fine.
SESSION_SECRET=replace-this-with-a-long-random-string

# Port the Node.js process listens on. Hostinger sets this automatically — leave blank in production.
PORT=3001
